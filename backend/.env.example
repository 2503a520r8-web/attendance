NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER/attendsmart?retryWrites=true&w=majority
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Comma-separated allowed browser origins; leave blank when frontend is served by this same backend service.
CORS_ORIGIN=
# Required to register staff accounts. Keep private; never commit the real value.
STAFF_INVITE_CODE=GENERATE_A_LONG_RANDOM_INVITE_CODE
# Campus geofence (replace with your institution's actual coordinates)
CAMPUS_LAT=17.6020
CAMPUS_LNG=78.1590
CAMPUS_RADIUS_METERS=250
# Optional SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional Twilio SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
